{
  "description": "Jev supervision for conductor-max slice workers: done-gate on stop, health steering while working.",
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent_stop.py\"", "timeout": 900}
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use.py\"", "timeout": 30}
        ]
      }
    ]
  }
}
